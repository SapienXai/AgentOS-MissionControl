{
  "name": "agentos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:release": "node packages/agentos/scripts/check-release-consistency.mjs",
    "build:agentos-package": "pnpm check:release && node packages/agentos/scripts/run-prepack.mjs",
    "pack:agentos": "pnpm check:release && npm pack ./packages/agentos --pack-destination /tmp --cache /tmp/agentos-npm-cache",
    "smoke:agentos-package": "node packages/agentos/scripts/smoke-package.mjs",
    "smoke:mission-control": "node scripts/mission-control-browser-smoke.mjs",
    "smoke:secure-browser": "node scripts/secure-browser-integration-smoke.mjs",
    "smoke:runtime-golden": "node scripts/openclaw-runtime-golden-smoke.mjs",
    "openclaw:runtime-cert": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-runtime-certification.ts",
    "openclaw:official-transport-cert": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-official-transport-certification.ts",
    "openclaw:official-lifecycle-cert": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-official-gateway-lifecycle-certification.ts",
    "openclaw:official-production-cert": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-official-production-certification.ts",
    "openclaw:lifecycle-e2e": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-lifecycle-e2e.ts",
    "openclaw:identity-e2e": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-identity-e2e.ts",
    "openclaw:multi-user-e2e": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-multi-user-e2e.ts",
    "openclaw:multi-user-collaboration-certification": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-multi-user-collaboration-certification.ts",
    "openclaw:automation-e2e": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-automation-e2e.ts",
    "openclaw:session-task-e2e": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-session-task-e2e.ts",
    "openclaw:native-work-cert": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-native-work-certification.ts",
    "openclaw:skills-capabilities-cert": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-skills-effective-capabilities-certification.ts",
    "openclaw:native-memory-cert": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-native-memory-certification.ts",
    "openclaw:native-doctor-cert": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-native-doctor-certification.ts",
    "openclaw:native-doctor-hardening-cert": "OPENCLAW_NATIVE_DOCTOR_HARDENING=1 OPENCLAW_NATIVE_DOCTOR_OUTPUT=docs/evidence/openclaw-2026.9.2-doctor-update-recovery-hardening.json node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-native-doctor-certification.ts",
    "openclaw:human-control-cert": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-human-control-certification.ts",
    "openclaw:capability-truthfulness-skills-cert": "OPENCLAW_SKILLS_EFFECTIVE_SEED=1 node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-skills-effective-capabilities-certification.ts",
    "openclaw:fresh-baseline-e2e": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-fresh-baseline-e2e.ts",
    "openclaw:migration-e2e": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-migration-e2e.ts",
    "openclaw:final-certification": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-final-certification.ts",
    "start": "next start",
    "lint": "eslint .",
    "openclaw:compat": "node -r ./tests/register-paths.cjs -r jiti/register.js scripts/openclaw-compat.ts",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "test": "node -r ./tests/register-paths.cjs -r jiti/register.js --test",
    "publish:agentos": "pnpm check:release && npm publish ./packages/agentos --access public --cache /tmp/agentos-npm-cache"
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.9.2",
    "@openclaw/gateway-protocol": "2026.9.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@xyflow/react": "^12.8.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.7.4",
    "next": "^16.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-icons": "^16.13.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "ws": "^8.20.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.2.0",
    "jiti": "1.21.7",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2"
  }
}
